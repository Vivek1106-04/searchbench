# Copy to .env (gitignored) and fill in. Only a live `bench run` or `bench judge`
# reads these; tests never do.

# --- search vendors ----------------------------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Optional vendors, used only when a key is set.
PARALLEL_API_KEY=
BRAVE_API_KEY=

# --- judge (Gemini on Vertex AI, auth via Application Default Credentials) ---
# Run `gcloud auth application-default login` once; no API key is used.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
